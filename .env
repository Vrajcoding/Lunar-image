# Root environment file — consumed automatically by `docker compose`.
# These are the HOST ports each service is published on. The ports *inside*
# the containers are fixed (frontend:80, backend:8000, ml-service:8001) and
# are not affected by these values.
#
# docker-compose.yml also hard-codes sensible defaults (${VAR:-default}), so
# the stack still comes up even if this file is missing.

BACKEND_PORT=8000
ML_SERVICE_PORT=8001
FRONTEND_PORT=3000
